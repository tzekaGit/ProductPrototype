@section Scripts {
    <script src="~/js/buildproducttable.js"></script>
    <script src="~/js/templates.js"></script>
    <script>


        // Execute the rendering function when the page is ready
        $(document).ready(function () {
			const $table = $("#productTable");
			const tableData = @Json.Serialize(Model.ProductDetails);
	
				 tableData.forEach((product, index) => {

                    if(product.parentGroupedProductId==0)
					{
					let headerData =
						{
							name: product.productName,
							length: product.specificationOptionName
						};
						// Parent row
						const productHeaderHtml = benchHeader_Template.replace(/{(\w+)}/g, (match, key) => headerData[key] ?? match);
						$tbody.append(productHeaderHtml);
					}
					else
					{
						$table.append(buildVariantRow(product, index));
					}
				});
				
        });
    </script>
}
