    .purple { background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.1) 10%, rgba(255,255,255,0) 25%), #8e44ad; }
    .red { background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.1) 10%, rgba(255,255,255,0) 25%), #ff3333; }
    .burgundy { background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.1) 10%, rgba(255,255,255,0) 25%), #800020; }
    .orange { background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.1) 10%, rgba(255,255,255,0) 25%), #ff7b00; }
    .beige { background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.1) 10%, rgba(255,255,255,0) 25%), #f5f5dc; }
    .black { background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0.1) 10%, rgba(255,255,255,0) 25%), #000000; }

    /* Textured Colors */
