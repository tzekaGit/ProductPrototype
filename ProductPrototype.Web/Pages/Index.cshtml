@section Scripts {
    <script>
        const $table = $("#productTable");
        const $tbody = $("#productTable tbody");
        const tableData = @Json.Serialize(variants);


         let index = 0;
    </script>

    <script src="~/js/buildproducttable.js"></script>
    <script src="~/js/templates.js"></script>
    <script src="~/js/product-colors.js"></script>
  
    <script>
        let productAttributeValues = @Json.Serialize(productAttributeValues);

        // Execute the rendering function when the page is ready
        $(document).ready(function () {
            let productLength = "";
            let modelIndex = 1;
                tableData.forEach((prod) => 
                {
                    if(prod.parentGroupedProductId==0)
                    {
                       var prodHeader = prod.specificationOptionName.split("|");
                       let headerData = null;
                       
                       const headerTemplate = @Html.Raw(prodGrp_Template);
                       let cssClass = headerTemplate.CssClass;
                       const productTemplate = tableData[0].productTemplate;

                       let productCells = headerTemplate.HeaderTmp.split(".")[0][0];
                       let headerCells = headerTemplate.HeaderTmp.split(".")[1][0];
                      
                       $(".productHeaderBar img").attr(headerTemplate.TitleBgImg);
                       if(prodHeader.length > 1)
                           headerData =
                            {
                                name1: prodHeader[0],
                                name2: prodHeader[1],
                                cssClass: cssClass,
                                colspan:  productCells - headerCells + 1
                            };
                        else
                          headerData =
                            {
                                name1: prod.specificationOptionName,
                                name2: "",
                                cssClass: cssClass,
                                colspan:  productCells - headerCells + 1
                            };
                      
                        let prodGrp_Template = null;
                        
                        
                        if(headerTemplate.HeaderTmp.indexOf("2HCell")>=0){
                            prodGrp_Template = T2CellProductGroupHeader_Template;
                        }
                        else if(headerTemplate.HeaderTmp.indexOf("4HCell")>=0)
                        {
                            prodGrp_Template = T4CellproductGroupHeaderWithDiscount_Template;
                        }

                        const productHeaderHtml = prodGrp_Template.replace(/{(\w+)}/g, (match, key) => headerData[key] ?? match);
                        $tbody.append(productHeaderHtml);
                    }
                    else
                    {
                        //Create dimesions table
                         $table.append(buildTableBody(prod));
                      }
                 
                });
                    
                
            createProductColors();
            const navData = @Html.Raw(Model.Navigations);
            for (const navItem of navData) {
                $(".navMenu").append(`<div class="menu"><a href="/?id=${navItem.Id}&sku=${navItem.Sku}" class="label">${navItem.Name}</a></div>`);
            }

        });
    </script>
}
