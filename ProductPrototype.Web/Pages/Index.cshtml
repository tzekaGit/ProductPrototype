@page
@using ProductPrototype.DbAccess;
@using ProductPrototype.DbAccess.Data.Models

@model IndexModel
@{
    ViewData["Title"] = "Home page";

    var productInfo = Model.ProductDetails.Where(prod => prod.ParentGroupedProductId == 0)
                                          .FirstOrDefault();

    string fullDescription = string.Empty;


    fullDescription = Html.Raw(productInfo?.FullDescription
                      ?.Replace("{short-description}", productInfo.ShortDescription)
                      ?.Replace("{product-header-title}", productInfo.Name)) + "";

    List<ProductAttributeValue> productAttributeValues = default;
    if (Model.ProductDetails?.Count()>1){

        productAttributeValues = Model?.ProductDetails?
                                 .ElementAtOrDefault(1)? // Safely gets item at index 0
                                 .ProductAttributes?
                                 .ElementAtOrDefault(0)? // Safely gets item at index 0 of list2
                                 .ProductAttributeValues;

    }

    var variants = Model.ProductDetails;
    var bgImage = Model.ProductTemplates.TableHeaderBackgroud;
}

