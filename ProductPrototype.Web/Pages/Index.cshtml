@section Scripts {
    <script>
        const $table = $("#productTable");
        const $dimension = $(".dimT");
        const $tbody = $("#productTable tbody");
        const tableData = @Json.Serialize(variants);
         let index = 0;
    </script>

    <script src="~/js/buildproducttable.js"></script>
    <script src="~/js/templates.js"></script>
    <script src="~/js/product-colors.js"></script>
  
    <script>
        let productAttributeValues = @Json.Serialize(productAttributeValues);

        // Execute the rendering function when the page is ready
        $(document).ready(function () {
      
            let dimensionGroup = {};
            let productLength = "";
            let modelIndex = 1;
                tableData.forEach((prod) => 
                {
                    if(prod.parentGroupedProductId==0)
                    {
                       var prodHeader = prod.specificationOptionName.split("|");
                       let headerData = null;
                       if(prodHeader.length > 1)
                           headerData =
                            {
                                name1: prodHeader[0],
                                name2: prodHeader[1]
                            };
                        else
                          headerData =
                            {
                                name1: prod.specificationOptionName,
                                name2: ""
                            };
                        
                        const productHeaderHtml = benchHeader_Template.replace(/{(\w+)}/g, (match, key) => headerData[key] ?? match);
                        $tbody.append(productHeaderHtml);
                    }
                    else
                    {
                        //Create dimesions table
                        let type = prod.specificationOptionName.trim().toLowerCase();
                            type = type.replace(/\s+/g, '-');
                            if (!dimensionGroup[type]) 
                                dimensionGroup[type] = [];

                            if( dimensionGroup[type].length ==0)
                            {
                                let productData =
                                {
                                    length: prod.length,
                                    width: prod.width,
                                    height: prod.height,
                                    specificationOptionName:"Model " + modelIndex++
                                };
                                dimensionGroup[type].push(productData);
                                const productDimensionsHtml = dimensions_template.replace(/{(\w+)}/g, (match, key) => productData[key] ?? match);
                                $dimension.after(productDimensionsHtml);
                            }
                         $table.append(buildTableBody(prod));
                      }
                 
                });

                
            createProductColors();
        });
    </script>
}
